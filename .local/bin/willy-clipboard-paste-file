#!/bin/bash

# Drop-in replacement for omarchy-clipboard-paste-file that pastes with Ctrl+V.
# See willy-clipboard-paste-text for why Shift+Insert isn't good enough.

copy_only=false

if [[ ${1:-} == "--copy-only" ]]; then
  copy_only=true
  shift
fi

mime=${1:-}
path=${2:-}

if [[ -z $mime || -z $path ]]; then
  echo "Usage: willy-clipboard-paste-file [--copy-only] <mime-type> <path>" >&2
  exit 1
fi

# Terminals take Shift+Insert, everything else takes Ctrl+V — same split as
# Omarchy's universal paste (default/hypr/bindings/clipboard.lua). Mirrors
# basecamp/omarchy#8350 so this runs what that PR proposes.
paste_into_focused_window() {
  if hyprctl -j activewindow 2>/dev/null | jq -e '[.tags[]? | sub("\\*$"; "")] | index("terminal")' >/dev/null; then
    wtype -M shift -k Insert -m shift 2>/dev/null || true
  else
    wtype -M ctrl v -m ctrl 2>/dev/null || true
  fi
}

[[ -r $path ]] || exit 1

wl-copy --type "$mime" < "$path"

[[ $copy_only == "true" ]] && exit

sleep 0.15
paste_into_focused_window
